# Financial AI Platform - Environment Configuration

# Ollama LLM Model Selection
# Options:
#   qwen2.5:1.5b  - Fastest, lightweight (~1GB RAM), ideal for CPU systems
#   qwen2.5:7b    - High accuracy, balanced (~5GB RAM), recommended for 16GB RAM systems
#   qwen2.5:14b   - Maximum reasoning, heavy (~10GB RAM), requires GPU or >16GB RAM
OLLAMA_MODEL=qwen2.5:1.5b

# Ollama Host (Docker internal URL)
OLLAMA_HOST=http://ai-engine:11434

# MongoDB Settings
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=financial_ai

# Frontend Settings
VITE_API_URL=http://localhost:8000/api
